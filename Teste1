--[[
  SCRIPT PVP HUB PARA ROBLOX
  FUNÇÕES: AIMBOT, AIMLOCK, ESP (CAIXAS, LINHAS, NOMES, SAÚDE, DISTÂNCIA)
  BOTÃO PARA ABRIR/FECHAR O HUB (TECLA 'X' OU BOTÃO NA TELA)
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Camera = workspace.CurrentCamera
local LocalPlayer = Players.LocalPlayer
local Mouse = LocalPlayer:GetMouse()

-- ===== CONFIGURAÇÕES =====
local Config = {
    AimbotEnabled = false,
    AimlockEnabled = false,
    ESPEnabled = false,
    ShowBoxes = true,
    ShowLines = true,
    ShowNames = true,
    ShowHealth = true,
    ShowDistance = true,
    ESPColor = Color3.new(0, 1, 0),
    AimPart = "Head", -- ou "HumanoidRootPart"
    FOV = 200,
    Smoothness = 0.3,
}

-- ===== VARIÁVEIS GLOBAIS =====
local ToggleKey = Enum.KeyCode.X
local HubVisible = false
local SelectedTarget = nil
local ESPObjects = {}
local ScreenGui = nil
local HubFrame = nil

-- ===== FUNÇÕES AUXILIARES =====
local function IsValidTarget(player)
    if not player then return false end
    if player == LocalPlayer then return false end
    if not player.Character or not player.Character:FindFirstChild("Humanoid") then return false end
    if player.Character.Humanoid.Health <= 0 then return false end
    if player.Team == LocalPlayer.Team and LocalPlayer.Team ~= nil then return false end
    return true
end

local function GetClosestPlayer()
    local closest = nil
    local shortestDistance = Config.FOV
    local mousePos = Vector2.new(Mouse.X, Mouse.Y)
    
    for _, player in pairs(Players:GetPlayers()) do
        if IsValidTarget(player) then
            local part = player.Character:FindFirstChild(Config.AimPart) or player.Character:FindFirstChild("HumanoidRootPart")
            if part then
                local screenPos, onScreen = Camera:WorldToViewportPoint(part.Position)
                if onScreen then
                    local distance = (Vector2.new(screenPos.X, screenPos.Y) - mousePos).Magnitude
                    if distance < shortestDistance then
                        shortestDistance = distance
                        closest = player
                    end
                end
            end
        end
    end
    return closest
end

-- ===== AIMBOT =====
local function Aimbot()
    if not Config.AimbotEnabled then return end
    
    local target = GetClosestPlayer()
    if target then
        local part = target.Character:FindFirstChild(Config.AimPart) or target.Character:FindFirstChild("HumanoidRootPart")
        if part then
            local lookAt = part.Position - Camera.CFrame.Position
            local newCFrame = CFrame.new(Camera.CFrame.Position, Camera.CFrame.Position + lookAt)
            Camera.CFrame = Camera.CFrame:Lerp(newCFrame, Config.Smoothness)
        end
    end
end

-- ===== AIMLOCK =====
local function Aimlock()
    if not Config.AimlockEnabled or not SelectedTarget then return end
    
    if not IsValidTarget(SelectedTarget) then
        SelectedTarget = nil
        return
    end
    
    local part = SelectedTarget.Character:FindFirstChild(Config.AimPart) or SelectedTarget.Character:FindFirstChild("HumanoidRootPart")
    if part then
        local lookAt = part.Position - Camera.CFrame.Position
        local newCFrame = CFrame.new(Camera.CFrame.Position, Camera.CFrame.Position + lookAt)
        Camera.CFrame = Camera.CFrame:Lerp(newCFrame, Config.Smoothness)
    end
end

-- ===== ESP =====
local function CreateESP(player)
    if not player or not player.Character then return end
    
    local humanoid = player.Character:FindFirstChild("Humanoid")
    if not humanoid then return end
    
    local rootPart = player.Character:FindFirstChild("HumanoidRootPart")
    if not rootPart then return end
    
    -- CAIXA
    local box = Instance.new("BoxHandleAdornment")
    box.Size = Vector3.new(3, 5, 1.5)
    box.Adornee = rootPart
    box.AlwaysOnTop = true
    box.ZIndex = 0
    box.Color3 = Config.ESPColor
    box.Transparency = 0.5
    
    -- LINHA
    local line = Instance.new("LineHandleAdornment")
    line.Adornee = rootPart
    line.AlwaysOnTop = true
    line.ZIndex = 0
    line.Color3 = Config.ESPColor
    line.Thickness = 2
    line.Transparency = 0.7
    
    -- NOME
    local nameTag = Instance.new("BillboardGui")
    nameTag.Adornee = rootPart
    nameTag.Size = UDim2.new(0, 200, 0, 50)
    nameTag.StudsOffset = Vector3.new(0, 3, 0)
    nameTag.AlwaysOnTop = true
    
    local nameLabel = Instance.new("TextLabel")
    nameLabel.Size = UDim2.new(1, 0, 1, 0)
    nameLabel.BackgroundTransparency = 1
    nameLabel.Text = player.Name
    nameLabel.TextColor3 = Config.ESPColor
    nameLabel.TextScaled = true
    nameLabel.Parent = nameTag
    
    -- SAÚDE
    local healthTag = Instance.new("BillboardGui")
    healthTag.Adornee = rootPart
    healthTag.Size = UDim2.new(0, 100, 0, 20)
    healthTag.StudsOffset = Vector3.new(0, 2.5, 0)
    healthTag.AlwaysOnTop = true
    
    local healthBar = Instance.new("Frame")
    healthBar.Size = UDim2.new(1, 0, 1, 0)
    healthBar.BackgroundColor3 = Color3.new(0, 1, 0)
    healthBar.BorderSizePixel = 0
    
    local healthBg = Instance.new("Frame")
    healthBg.Size = UDim2.new(1, 0, 1, 0)
    healthBg.BackgroundColor3 = Color3.new(0.2, 0.2, 0.2)
    healthBg.BorderSizePixel = 0
    healthBg.Parent = healthTag
    
    healthBar.Parent = healthTag
    
    -- DISTÂNCIA
    local distTag = Instance.new("BillboardGui")
    distTag.Adornee = rootPart
    distTag.Size = UDim2.new(0, 100, 0, 20)
    distTag.StudsOffset = Vector3.new(0, 2, 0)
    distTag.AlwaysOnTop = true
    
    local distLabel = Instance.new("TextLabel")
    distLabel.Size = UDim2.new(1, 0, 1, 0)
    distLabel.BackgroundTransparency = 1
    distLabel.Text = "0m"
    distLabel.TextColor3 = Config.ESPColor
    distLabel.TextScaled = true
    distLabel.Parent = distTag
    
    -- ARMAZENAR REFERÊNCIAS
    local espData = {
        Box = box,
        Line = line,
        NameTag = nameTag,
        HealthTag = healthTag,
        HealthBar = healthBar,
        DistTag = distTag,
        DistLabel = distLabel,
        Player = player,
        RootPart = rootPart,
    }
    table.insert(ESPObjects, espData)
    
    -- VISIBILIDADE
    box.Visible = Config.ShowBoxes
    line.Visible = Config.ShowLines
    nameTag.Enabled = Config.ShowNames
    healthTag.Enabled = Config.ShowHealth
    distTag.Enabled = Config.ShowDistance
end

local function UpdateESP()
    for _, esp in pairs(ESPObjects) do
        if esp.Player and esp.Player.Character and esp.Player.Character:FindFirstChild("Humanoid") then
            local humanoid = esp.Player.Character.Humanoid
            if humanoid.Health > 0 then
                -- ATUALIZAR SAÚDE
                local healthPercent = humanoid.Health / humanoid.MaxHealth
                esp.HealthBar.Size = UDim2.new(healthPercent, 0, 1, 0)
                esp.HealthBar.BackgroundColor3 = Color3.new(1 - healthPercent, healthPercent, 0)
                
                -- ATUALIZAR DISTÂNCIA
                local dist = (esp.RootPart.Position - Camera.CFrame.Position).Magnitude
                esp.DistLabel.Text = math.floor(dist) .. "m"
                
                -- CORES DINÂMICAS PARA INIMIGO/AMIGO
                if esp.Player.Team == LocalPlayer.Team and LocalPlayer.Team ~= nil then
                    esp.Box.Color3 = Color3.new(0, 0, 1)
                    esp.Line.Color3 = Color3.new(0, 0, 1)
                    esp.NameLabel.TextColor3 = Color3.new(0, 0, 1)
                    esp.DistLabel.TextColor3 = Color3.new(0, 0, 1)
                else
                    esp.Box.Color3 = Config.ESPColor
                    esp.Line.Color3 = Config.ESPColor
                    esp.NameLabel.TextColor3 = Config.ESPColor
                    esp.DistLabel.TextColor3 = Config.ESPColor
                end
            end
        end
    end
end

local function ClearESP()
    for _, esp in pairs(ESPObjects) do
        esp.Box:Destroy()
        esp.Line:Destroy()
        esp.NameTag:Destroy()
        esp.HealthTag:Destroy()
        esp.DistTag:Destroy()
    end
    ESPObjects = {}
end

local function RefreshESP()
    ClearESP()
    for _, player in pairs(Players:GetPlayers()) do
        if IsValidTarget(player) then
            CreateESP(player)
        end
    end
end

-- ===== HUB GUI =====
local function CreateHub()
    ScreenGui = Instance.new("ScreenGui")
    ScreenGui.Parent = LocalPlayer:WaitForChild("PlayerGui")
    ScreenGui.ResetOnSpawn = false
    
    HubFrame = Instance.new("Frame")
    HubFrame.Size = UDim2.new(0, 350, 0, 500)
    HubFrame.Position = UDim2.new(0.5, -175, 0.5, -250)
    HubFrame.BackgroundColor3 = Color3.new(0.1, 0.1, 0.15)
    HubFrame.BackgroundTransparency = 0.2
    HubFrame.BorderSizePixel = 0
    HubFrame.Visible = false
    HubFrame.Parent = ScreenGui
    
    -- TÍTULO
    local title = Instance.new("TextLabel")
    title.Size = UDim2.new(1, 0, 0, 40)
    title.BackgroundColor3 = Color3.new(0.2, 0.2, 0.25)
    title.Text = "⚔️ PVP HUB ⚔️"
    title.TextColor3 = Color3.new(1, 1, 1)
    title.TextScaled = true
    title.Font = Enum.Font.GothamBold
    title.Parent = HubFrame
    
    -- BOTÃO FECHAR
    local closeBtn = Instance.new("TextButton")
    closeBtn.Size = UDim2.new(0, 30, 0, 30)
    closeBtn.Position = UDim2.new(1, -35, 0, 5)
    closeBtn.Text = "✕"
    closeBtn.TextColor3 = Color3.new(1, 1, 1)
    closeBtn.BackgroundColor3 = Color3.new(0.8, 0.2, 0.2)
    closeBtn.BorderSizePixel = 0
    closeBtn.Parent = HubFrame
    closeBtn.MouseButton1Click:Connect(function()
        HubVisible = false
        HubFrame.Visible = false
    end)
    
    -- FUNÇÕES
    local yPos = 50
    local functions = {
        {name = "AIMBOT", key = "AimbotEnabled"},
        {name = "AIMLOCK", key = "AimlockEnabled"},
        {name = "ESP", key = "ESPEnabled"},
        {name = "CAIXAS", key = "ShowBoxes"},
        {name = "LINHAS", key = "ShowLines"},
        {name = "NOMES", key = "ShowNames"},
        {name = "SAÚDE", key = "ShowHealth"},
        {name = "DISTÂNCIA", key = "ShowDistance"},
    }
    
    for _, func in pairs(functions) do
        local btn = Instance.new("TextButton")
        btn.Size = UDim2.new(0.9, 0, 0, 35)
        btn.Position = UDim2.new(0.05, 0, 0, yPos)
        btn.Text = func.name .. ": " .. tostring(Config[func.key])
        btn.TextColor3 = Color3.new(1, 1, 1)
        btn.BackgroundColor3 = Color3.new(0.2, 0.2, 0.3)
        btn.BorderSizePixel = 0
        btn.Parent = HubFrame
        
        btn.MouseButton1Click:Connect(function()
            Config[func.key] = not Config[func.key]
            btn.Text = func.name .. ": " .. tostring(Config[func.key])
            
            if func.key == "ESPEnabled" then
                if Config.ESPEnabled then
                    RefreshESP()
                else
                    ClearESP()
                end
            elseif func.key:find("Show") then
                for _, esp in pairs(ESPObjects) do
                    if func.key == "ShowBoxes" then esp.Box.Visible = Config.ShowBoxes end
                    if func.key == "ShowLines" then esp.Line.Visible = Config.ShowLines end
                    if func.key == "ShowNames" then esp.NameTag.Enabled = Config.ShowNames end
                    if func.key == "ShowHealth" then esp.HealthTag.Enabled = Config.ShowHealth end
                    if func.key == "ShowDistance" then esp.DistTag.Enabled = Config.ShowDistance end
                end
            end
        end)
        yPos = yPos + 45
    end
    
    -- BOTÃO SELECIONAR ALVO (AIMLOCK)
    local targetBtn = Instance.new("TextButton")
    targetBtn.Size = UDim2.new(0.9, 0, 0, 35)
    targetBtn.Position = UDim2.new(0.05, 0, 0, yPos)
    targetBtn.Text = "SELECIONAR ALVO (CLICK)"
    targetBtn.TextColor3 = Color3.new(1, 1, 1)
    targetBtn.BackgroundColor3 = Color3.new(0.3, 0.1, 0.3)
    targetBtn.BorderSizePixel = 0
    targetBtn.Parent = HubFrame
    
    targetBtn.MouseButton1Click:Connect(function()
        local target = GetClosestPlayer()
        if target then
            SelectedTarget = target
            targetBtn.Text = "ALVO: " .. target.Name
        else
            SelectedTarget = nil
            targetBtn.Text = "SEM ALVO"
        end
    end)
end

-- ===== EVENTOS =====
-- TECLA PARA ABRIR/FECHAR
UserInputService.InputBegan:Connect(function(input, processed)
    if processed then return end
    if input.KeyCode == ToggleKey then
        HubVisible = not HubVisible
        if HubFrame then
            HubFrame.Visible = HubVisible
        end
    end
end)

-- QUANDO UM JOGADOR ENTRA/SAI
Players.PlayerAdded:Connect(function(player)
    if Config.ESPEnabled then
        player.CharacterAdded:Connect(function()
            wait(0.5)
            CreateESP(player)
        end)
    end
end)

Players.PlayerRemoving:Connect(function(player)
    for i, esp in pairs(ESPObjects) do
        if esp.Player == player then
            esp.Box:Destroy()
            esp.Line:Destroy()
            esp.NameTag:Destroy()
            esp.HealthTag:Destroy()
            esp.DistTag:Destroy()
            table.remove(ESPObjects, i)
        end
    end
end)

-- ===== LOOP PRINCIPAL =====
CreateHub()

RunService.RenderStepped:Connect(function()
    if Config.AimbotEnabled then
        Aimbot()
    end
    
    if Config.AimlockEnabled then
        Aimlock()
    end
    
    if Config.ESPEnabled then
        UpdateESP()
    end
end)

-- ===== INICIAR ESP SE JÁ ESTIVER ATIVO =====
if Config.ESPEnabled then
    wait(1)
    RefreshESP()
end

-- ===== MENSAGEM INICIAL =====
print("🔫 PVP HUB CARREGADO! Use a tecla 'X' para abrir/fechar.")
