            HealthBar = healthBar,
            DistTag = distTag,
            DistLabel = distLabel,
            Player = player,
            RootPart = rootPart,
        }
        table.insert(ESPObjects, espData)
        
        box.Visible = Config.ShowBoxes
        boxOutline.Visible = Config.ShowBoxes
        line.Visible = Config.ShowLines
        nameTag.Enabled = Config.ShowNames
        healthTag.Enabled = Config.ShowHealth
        distTag.Enabled = Config.ShowDistance
    end

    local function UpdateESP()
        for _, esp in pairs(ESPObjects) do
            if esp.Player and esp.Player.Character and esp.Player.Character:FindFirstChild("Humanoid") then
                local humanoid = esp.Player.Character.Humanoid
                if humanoid.Health > 0 then
                    local healthPercent = math.max(0, humanoid.Health / humanoid.MaxHealth)
                    esp.HealthBar.Size = UDim2.new(healthPercent, 0, 1, 0)
                    esp.HealthBar.BackgroundColor3 = Color3.fromRGB(
                        255 * (1 - healthPercent),
                        255 * healthPercent,
                        0
                    )
                    
                    local dist = (esp.RootPart.Position - Camera.CFrame.Position).Magnitude
                    esp.DistLabel.Text = math.floor(dist) .. "m"
                    
                    local espColor = Config.ESPColor
                    if esp.Player.Team == LocalPlayer.Team and LocalPlayer.Team ~= nil then
                        espColor = Color3.fromRGB(0, 200, 255)
                    end
                    
                    esp.Box.Color3 = espColor
                    esp.BoxOutline.Color3 = espColor
                    esp.Line.Color3 = espColor
                    esp.NameLabel.TextColor3 = espColor
                end
            end
        end
    end

    local function ClearESP()
        for _, esp in pairs(ESPObjects) do
            pcall(function()
                if esp.Group then esp.Group:Destroy() end
            end)
        end
        ESPObjects = {}
    end

    local function RefreshESP()
        ClearESP()
        if Config.ESPEnabled then
            for _, player in pairs(Players:GetPlayers()) do
                if IsValidTarget(player) then
                    CreateESP(player)
                end
            end
        end
    end

    -- ===== INTERFACE =====
