-- ========== AIMBOT ==========
local function GetBestTarget()
    if not Mouse then return nil end
    local center = Vector2.new(Mouse.X, Mouse.Y)
    local best, bestScore = nil, math.huge
    
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local head = player.Character:FindFirstChild("Head")
            local humanoid = player.Character:FindFirstChild("Humanoid")
            if head and humanoid and humanoid.Health > 0 then
                local pos, onScreen = Camera:WorldToScreenPoint(head.Position)
                if onScreen then
                    local dist = (Vector2.new(pos.X, pos.Y) - center).Magnitude
                    if dist < FOV and dist < bestScore then
                        bestScore = dist
                        best = player
                    end
                end
            end
        end
    end
    return best
end

RunService.RenderStepped:Connect(function()
    if PvPFunctions.Aimbot or PvPFunctions.Aimlock then
        if not targetLocked or not currentTarget or not currentTarget.Character then
            local newTarget = GetBestTarget()
            if newTarget then
                currentTarget = newTarget
                targetLocked = true
            else
                return
            end
        end
        
        local head = currentTarget.Character:FindFirstChild("Head")
        if head then
            local pos = head.Position
            if PvPFunctions.Aimbot then
                Camera.CFrame = CFrame.lookAt(Camera.CFrame.Position, pos)
            end
            if PvPFunctions.Aimlock then
                local dist = (pos - Camera.CFrame.Position).Magnitude
                if dist < 300 then
                    Camera.CFrame = CFrame.lookAt(Camera.CFrame.Position, pos)
                else
                    targetLocked = false
                end
            end
        end
    end
    
    -- Auto Spin
    if PvPFunctions.AutoSpin and LocalPlayer.Character then
        local hrp = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        if hrp then
            hrp.CFrame = hrp.CFrame * CFrame.Angles(0, 0.02, 0)
        end
    end
end)

-- ========== ESP ==========
local espObjects = {}

function UpdateESP()
    for player, list in pairs(espObjects) do
        for _, obj in pairs(list) do 
            pcall(function() obj:Destroy() end)
        end
        espObjects[player] = nil
    end
    
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            pcall(function()
                local char = player.Character
                if not char then return end
                local head = char:FindFirstChild("Head")
                if not head then return end
                
                local espList = {}
                
                if PvPFunctions.ESPBox then
                    local box = Instance.new("BoxHandleAdornment")
                    box.Size = Vector3.new(2.5, 4.5, 1)
                    box.Adornee = char
                    box.Color3 = Color3.fromRGB(80, 200, 255)
                    box.Transparency = 0.4
                    box.ZIndex = 10
                    box.Parent = char
                    table.insert(espList, box)
                end
                
                if PvPFunctions.ESPHealth then
                    local bgui = Instance.new("BillboardGui")
                    bgui.Size = UDim2.new(0, 35, 0, 5)
                    bgui.Adornee = head
                    bgui.Parent = char
                    
                    local bar = Instance.new("Frame")
                    bar.Size = UDim2.new(1, 0, 1, 0)
                    bar.BackgroundColor3 = Color3.fromRGB(0, 200, 50)
                    bar.Parent = bgui
                    
                    local bg = Instance.new("Frame")
                    bg.Size = UDim2.new(1, 0, 1, 0)
                    bg.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
                    bg.BackgroundTransparency = 0.5
                    bg.Parent = bgui
                    
                    local humanoid = char:FindFirstChild("Humanoid")
                    if humanoid then
                        humanoid:GetPropertyChangedSignal("Health"):Connect(function()
                            bar.Size = UDim2.new(humanoid.Health / humanoid.MaxHealth, 0, 1, 0)
                        end)
                    end
                    table.insert(espList, bgui)
  
