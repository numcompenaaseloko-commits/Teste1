-- [[ FOV CIRCLE ]] --
function updateFOV()
    if fovCircle then
        fovCircle:Destroy()
        fovCircle = nil
    end
    
    if aimbotEnabled or aimlockEnabled then
        fovCircle = Instance.new("CircleHandleAdornment")
        fovCircle.Radius = fovSize/2
        fovCircle.Color3 = Color3.fromRGB(255, 50, 50)
        fovCircle.Transparency = 0.6
        fovCircle.Thickness = 2
        fovCircle.ZIndex = 0
        fovCircle.Parent = camera
    end
end

-- [[ LOOP PRINCIPAL ]] --
RunService.RenderStepped:Connect(function()
    -- Aimbot/Aimlock
    if aimbotEnabled or aimlockEnabled then
        local target = getClosestPlayer()
        if target and target.Character then
            local part = target.Character:FindFirstChild(targetPart)
            if part then
                camera.CFrame = CFrame.new(camera.CFrame.Position, part.Position)
                if aimlockEnabled then
                    selectedTarget = target
                end
            end
        end
    end
    
    -- ESP Update
    if espEnabled then
        updateESP()
    end
end)

