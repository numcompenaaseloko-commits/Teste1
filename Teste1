local function CreateToggle(text, default, callback)
    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(1, -5, 0, 30)
    frame.BackgroundColor3 = Color3.fromRGB(35, 45, 70)
    frame.BackgroundTransparency = 0.5
