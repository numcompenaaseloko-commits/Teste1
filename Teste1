-- FOV Circle Drawing
local fovCircle = Instance.new("Frame")
fovCircle.Size = UDim2.new(0, 2, 0, 2)
fovCircle.Position = UDim2.new(0.5, -1, 0.5, -1)
fovCircle.BackgroundTransparency = 1
fovCircle.Parent = ScreenGui

local function updateFOVCircle()
    if not Settings.Aimbot.ShowFOV or not Settings.Aimbot.Enabled then
        fovCircle.Visible = false
        return
    end
    
    fovCircle.Visible = true
    local size = Settings.Aimbot.FOV / Camera.FieldOfView * 500
    fovCircle.Size = UDim2.new(0, size, 0, size)
    fovCircle.Position = UDim2.new(0.5, -size/2, 0.5, -size/2)
    
    for _, child in pairs(fovCircle:GetChildren()) do
        if child:IsA("Frame") then
            child:Destroy()
        end
    end
    
    local segments = 36
    local radius = size / 2
    local center = size / 2
    
    for i = 0, segments do
        local angle = (i / segments) * math.pi * 2
        local x = center + radius * math.cos(angle)
        local y = center + radius * math.sin(angle)
        
        local point = Instance.new("Frame")
        point.Size = UDim2.new(0, Settings.Aimbot.FOVThickness, 0, Settings.Aimbot.FOVThickness)
        point.Position = UDim2.new(0, x - Settings.Aimbot.FOVThickness/2, 0, y - Settings.Aimbot.FOVThickness/2)
        point.BackgroundColor3 = Settings.Aimbot.FOVColor
        point.BackgroundTransparency = 0.3
        point.BorderSizePixel = 0
        point.Parent = fovCircle
    end
end

