-- ========== AIMBOT ==========
local Mouse = LocalPlayer:GetMouse()
local currentTarget = nil
local targetLocked = false

local function GetTarget()
    if not Mouse then return nil end
    local center = Vector2.new(Mouse.X, Mouse.Y)
    local best, bestScore = nil, math.huge
    
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local head = player.Character:FindFirstChild("Head")
            local humanoid = player.Character:FindFirstChild("Humanoid")
            if head and humanoid and humanoid.Health > 0 then
                local pos, onScreen = Camera:WorldToScreenPoint(head.Position)
                if onScreen then
                    local dist = (Vector2.new(pos.X, pos.Y) - center).Magnitude
                    if dist < FOV and dist < bestScore then
                        bestScore = dist
                        best = player
                    end
                end
            end
        end
    end
    return best
end

RunService.RenderStepped:Connect(function()
    PvPFunctions = PvPFunctions or {}
    
    if PvPFunctions.Aimbot or PvPFunctions.Aimlock then
        if not targetLocked or not currentTarget or not currentTarget.Character then
            local newTarget = GetTarget()
            if newTarget then
                currentTarget = newTarget
                targetLocked = true
            else
                return
            end
        end
        
        local head = currentTarget.Character:FindFirstChild("Head")
        if head then
            local pos = head.Position
            if PvPFunctions.Aimbot then
                Camera.CFrame = CFrame.lookAt(Camera.CFrame.Position, pos)
            end
            if PvPFunctions.Aimlock then
                local dist = (pos - Camera.CFrame.Position).Magnitude
                if dist < 300 then
                    Camera.CFrame = CFrame.lookAt(Camera.CFrame.Position, pos)
                else
                    targetLocked = false
                end
            end
        end
    end
end)

-- ========== ESP ==========
local espObjects = {}

function UpdateESP()
    for player, list in pairs(espObjects) do
        for _, obj in pairs(list) do 
            pcall(function() obj:Destroy() end)
        end
        espObjects[player] = nil
    end
    
    if not PvPFunctions or not PvPFunctions.ESP then return end
    
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            pcall(function()
                local char = player.Character
                if not char then return end
                local head = char:FindFirstChild("Head")
                if not head then return end
                
                local list = {}
                
                -- Box
                local box = Instance.new("BoxHandleAdornment")
                box.Size = Vector3.new(3, 5, 1.5)
                box.Adornee = char
                box.Color3 = Color3.fromRGB(0, 200, 255)
                box.Transparency = 0.3
                box.ZIndex = 10
                box.Parent = char
                table.insert(list, box)
                
                -- Nome
                local bgui = Instance.new("BillboardGui")
                bgui.Size = UDim2.new(0, 100, 0, 25)
                bgui.Adornee = head
                bgui.Parent = char
                
                local label = Instance.new("TextLabel")
                label.Size = UDim2.new(1, 0, 1, 0)
                label.BackgroundTransparency = 1
                label.Text = player.Name
                label.TextColor3 = Color3.fromRGB(255, 255, 255)
                label.TextScaled = true
                label.Font = Enum.Font.GothamBold
                label.Parent = bgui
                table.insert(list, bgui)
                
                espObjects[player] = list
            end)
        end
    end
end

