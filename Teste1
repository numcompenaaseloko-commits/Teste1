        local yPos = 5
        
        local function createButton(text, key, color)
            local btn = Instance.new("TextButton")
            btn.Size = UDim2.new(1, -10, 0, 38)
            btn.Position = UDim2.new(0, 0, 0, yPos)
            btn.Text = text .. ": " .. (Config[key] and "✔ ON" or "✘ OFF")
            btn.TextColor3 = Color3.fromRGB(255, 255, 255)
            btn.TextScaled = true
            btn.Font = Enum.Font.Gotham
            btn.BackgroundColor3 = Config[key] and Color3.fromRGB(0, 170, 255) or color or Color3.fromRGB(25, 25, 45)
            btn.BackgroundTransparency = 0.3
            btn.BorderSizePixel = 0
            btn.Parent = scrollFrame
            
            btn.MouseEnter:Connect(function()
                TweenService:Create(btn, TweenInfo.new(0.2), {BackgroundTransparency = 0.1}):Play()
            end)
            btn.MouseLeave:Connect(function()
                TweenService:Create(btn, TweenInfo.new(0.2), {BackgroundTransparency = 0.3}):Play()
            end)
            
            btn.MouseButton1Click:Connect(function()
                Config[key] = not Config[key]
                btn.Text = text .. ": " .. (Config[key] and "✔ ON" or "✘ OFF")
                btn.BackgroundColor3 = Config[key] and Color3.fromRGB(0, 170, 255) or color or Color3.fromRGB(25, 25, 45)
                
                if key == "ESPEnabled" then
                    if Config.ESPEnabled then
                        RefreshESP()
                    else
                        ClearESP()
                    end
                elseif key:find("Show") then
                    for _, esp in pairs(ESPObjects) do
                        if esp.Box then
                            if key == "ShowBoxes" then 
                                esp.Box.Visible = Config.ShowBoxes
                                esp.BoxOutline.Visible = Config.ShowBoxes
                            end
                            if key == "ShowLines" then esp.Line.Visible = Config.ShowLines end
                            if key == "ShowNames" then esp.NameTag.Enabled = Config.ShowNames end
                            if key == "ShowHealth" then esp.HealthTag.Enabled = Config.ShowHealth end
                            if key == "ShowDistance" then esp.DistTag.Enabled = Config.ShowDistance end
                        end
                    end
                end
            end)
            
            yPos = yPos + 42
            return btn
        end
        
        createButton("🎯 AIMBOT", "AimbotEnabled", Color3.fromRGB(25, 25, 45))
