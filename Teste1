-- ========== AIMBOT ==========
local function getTarget()
    if not Mouse then return nil end
    local center = Vector2.new(Mouse.X, Mouse.Y)
    local best, bestScore = nil, math.huge
    
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            local head = p.Character:FindFirstChild("Head")
            local hum = p.Character:FindFirstChild("Humanoid")
            if head and hum and hum.Health > 0 then
                local pos, on = Camera:WorldToScreenPoint(head.Position)
                if on then
                    local dist = (Vector2.new(pos.X, pos.Y) - center).Magnitude
                    if dist < FOV and dist < bestScore then
                        bestScore = dist
                        best = p
                    end
                end
            end
        end
    end
    return best
end

RunService.RenderStepped:Connect(function()
    if functions.Aimbot or functions.Aimlock then
        if not targetLocked or not currentTarget or not currentTarget.Character then
            local new = getTarget()
            if new then
                currentTarget = new
                targetLocked = true
            else
                return
            end
        end
        
        local head = currentTarget.Character:FindFirstChild("Head")
        if head then
            local pos = head.Position
            if functions.Aimbot then
                Camera.CFrame = CFrame.lookAt(Camera.CFrame.Position, pos)
            end
            if functions.Aimlock then
                if (pos - Camera.CFrame.Position).Magnitude < 300 then
                    Camera.CFrame = CFrame.lookAt(Camera.CFrame.Position, pos)
                else
                    targetLocked = false
                end
            end
        end
    end
end)

-- ========== ESP ==========
local espObjs = {}

function updateESP()
    for p, list in pairs(espObjs) do
        for _, obj in pairs(list) do pcall(obj.Destroy, obj) end
        espObjs[p] = nil
    end
    
    if not functions.ESP then return end
    
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then
            pcall(function()
                local char = p.Character
                if not char then return end
                local head = char:FindFirstChild("Head")
                if not head then return end
                
                local list = {}
                
                -- Box
                local box = Instance.new("BoxHandleAdornment")
                box.Size = Vector3.new(2.5, 4.5, 1)
                box.Adornee = char
                box.Color3 = Color3.fromRGB(0, 200, 255)
                box.Transparency = 0.3
                box.ZIndex = 10
                box.Parent = char
                table.insert(list, box)
                
                -- Nome
                local bg = Instance.new("BillboardGui")
                bg.Size = UDim2.new(0, 80, 0, 20)
                bg.Adornee = head
                bg.Parent = char
                
                local lbl = Instance.new("TextLabel")
                lbl.Size = UDim2.new(1, 0, 1, 0)
                lbl.BackgroundTransparency = 1
                lbl.Text = p.Name
                lbl.TextColor3 = Color3.fromRGB(255, 255, 255)
                lbl.TextScaled = true
                lbl.Font = Enum.Font.GothamBold
                lbl.Parent = bg
                table.insert(list, bg)
                
                espObjs[p] = list
            end)
        end
    end
end

