-- ========== SISTEMA AIMBOT CORRIGIDO ==========
-- Função para pegar APENAS O MELHOR ALVO (um único)
local function GetBestTarget()
    local bestTarget = nil
    local bestScore = math.huge
    local centerScreen = Vector2.new(Mouse.X, Mouse.Y)
    
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local head = player.Character:FindFirstChild("Head")
            local root = player.Character:FindFirstChild("HumanoidRootPart")
            
            if head and root then
                -- Verifica se o player está vivo
                local humanoid = player.Character:FindFirstChild("Humanoid")
                if humanoid and humanoid.Health > 0 then
                    local headPos = head.Position
                    local screenPos, onScreen = Camera:WorldToScreenPoint(headPos)
                    
                    if onScreen then
                        -- Distância do centro da tela
                        local distFromCenter = (Vector2.new(screenPos.X, screenPos.Y) - centerScreen).Magnitude
                        
                        -- Distância 3D do jogador
                        local dist3D = (headPos - Camera.CFrame.Position).Magnitude
                        
                        -- Score: prioriza alvos mais próximos do centro da tela E mais próximos
                        local score = distFromCenter + (dist3D / 10)
                        
                        -- Só considera se estiver dentro do FOV
                        if distFromCenter < FOV and score < bestScore then
                            bestScore = score
                            bestTarget = player
                        end
                    end
                end
            end
        end
    end
    
    return bestTarget
end

-- Função para verificar se o alvo ainda é válido
local function IsTargetValid(target)
    if not target then return false end
    if not target.Character then return false end
    
    local head = target.Character:FindFirstChild("Head")
    local humanoid = target.Character:FindFirstChild("Humanoid")
    
    if not head or not humanoid then return false end
    if humanoid.Health <= 0 then return false end
    
    -- Verifica se ainda está dentro do FOV
    local screenPos, onScreen = Camera:WorldToScreenPoint(head.Position)
    if not onScreen then return false end
    
    local distFromCenter = (Vector2.new(screenPos.X, screenPos.Y) - Vector2.new(Mouse.X, Mouse.Y)).Magnitude
    if distFromCenter > FOV * 1.5 then return false end -- Tolerância maior para não perder o alvo facilmente
    
    return true
end

-- Sistema de mira principal
RunService.RenderStepped:Connect(function()
    local aimbotEnabled = PvPFunctions.Aimbot
    local aimlockEnabled = PvPFunctions.Aimlock
    
    if not aimbotEnabled and not aimlockEnabled then
        currentTarget = nil
        targetLocked = false
        return
    end
    
    -- Se não tem alvo ou o alvo atual é inválido, procura um novo
    if not targetLocked or not IsTargetValid(currentTarget) then
        local newTarget = GetBestTarget()
        if newTarget then
            currentTarget = newTarget
            targetLocked = true
        else
            currentTarget = nil
            targetLocked = false
            return
        end
    end
    
    -- Se chegou aqui, tem um alvo válido
    if currentTarget and currentTarget.Character then
        local head = currentTarget.Character:FindFirstChild("Head")
        local root = currentTarget.Character:FindFirstChild("HumanoidRootPart")
        
        if head then
            local targetPosition = head.Position
            
            -- Para aimbot: mira na cabeça do alvo
            if aimbotEnabled then
                Camera.CFrame = CFrame.lookAt(Camera.CFrame.Position, targetPosition)
            end
            
            -- Para aimlock: trava na cabeça do alvo
            if aimlockEnabled then
                local dist3D = (targetPosition - Camera.CFrame.Position).Magnitude
                if dist3D < 300 then
                    Camera.CFrame = CFrame.lookAt(Camera.CFrame.Position, targetPosition)
                else
                    -- Se o alvo estiver muito longe, solta
                    targetLocked = false
                    currentTarget = nil
                end
            end
        end
    end
    
    -- Auto Spin
    if PvPFunctions.AutoSpin and LocalPlayer.Character then
        local hrp = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        if hrp then
            hrp.CFrame = hrp.CFrame * CFrame.Angles(0, 0.02, 0)
        end
    end
end)

-- ========== SISTEMA ESP ==========
local espObjects = {}

local function CreateESP(player)
    if espObjects[player] then
        for _, obj in pairs(espObjects[player]) do obj:Destroy() end
        espObjects[player] = nil
    end
    
    local char = player.Character
    if not char then return end
    
    local espList = {}
    local head = char:FindFirstChild("Head")
    if not head then return end
    
    if PvPFunctions.ESPBox then
        local box = Instance.new("BoxHandleAdornment")
        box.Size = Vector3.new(2.5, 4.5, 1)
        box.Adornee = char
        box.Color3 = Color3.fromRGB(80, 200, 255)
        box.Transparency = 0.4
        box.ZIndex = 10
        box.Parent = char
        table.insert(espList, box)
    end
    
    if PvPFunctions.ESPHealth then
        local bgui = Instance.new("BillboardGui")
        bgui.Size = UDim2.new(0, 35, 0, 5)
        bgui.Adornee = head
        bgui.Parent = char
        
        local bar = Instance.new("Frame")
        bar.Size = UDim2.new(1, 0, 1, 0)
        bar.BackgroundColor3 = Color3.fromRGB(0, 200, 50)
        bar.Parent = bgui
        
        local bg = Instance.new("Frame")
        bg.Size = UDim2.new(1, 0, 1, 0)
        bg.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
        bg.BackgroundTransparency = 0.5
        bg.Parent = bgui
        
        local humanoid = char:FindFirstChild("Humanoid")
        if humanoid then
            humanoid:GetPropertyChangedSignal("Health"):Connect(function()
                bar.Size = UDim2.new(humanoid.Health / humanoid.MaxHealth, 0, 1, 0)
                if humanoid.Health <= 0 then
                    UpdateESP()
                end
            end)
        end
        
        table.insert(espList, bgui)
    end
    
    if PvPFunctions.ESPName then
        local bgui = Instance.new("BillboardGui")
        bgui.Size = UDim2.new(0, 70, 0, 18)
        bgui.Adornee = head
        bgui.Parent = char
        
        local label = Instance.new("TextLabel")
        label.Size = UDim2.new(1, 0, 1, 0)
        label.BackgroundTransparency = 1
        label.Text = player.Name
        label.TextColor3 = Color3.fromRGB(255, 255, 255)
        label.TextScaled = true
        label.Font = Enum.Font.GothamBold
        label.Parent = bgui
        
        table.insert(espList, bgui)
    end
    
    espObjects[player] = espList
end

local function UpdateESP()
    for player, list in pairs(espObjects) do
        if list then
            for _, obj in pairs(list) do obj:Destroy() end
            espObjects[player] = nil
        end
    end
    
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            CreateESP(player)
        end
    end
end

