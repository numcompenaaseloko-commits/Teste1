-- Save/Load
local function saveSettings()
    local data = HttpService:JSONEncode(Settings)
    pcall(function()
        setclipboard(data)
        if writefile then writefile("SnowHub_Settings.json", data) end
    end)
    print("❄ Configurações salvas!")
end

local function loadSettings()
    pcall(function()
        if isfile and isfile("SnowHub_Settings.json") then
            local data = readfile("SnowHub_Settings.json")
            local loaded = HttpService:JSONDecode(data)
            if loaded then
                Settings = loaded
                print("❄ Configurações carregadas!")
            end
        end
    end)
end

