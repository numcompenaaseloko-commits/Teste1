local function LoadSnowHub()
    -- Verificar se já existe
    if game:FindFirstChild("SnowHubGUI") then
        game:FindFirstChild("SnowHubGUI"):Destroy()
    end

    local Players = game:GetService("Players")
    local RunService = game:GetService("RunService")
    local UserInputService = game:GetService("UserInputService")
    local TweenService = game:GetService("TweenService")
    local Camera = workspace.CurrentCamera
    local LocalPlayer = Players.LocalPlayer
    local Mouse = LocalPlayer:GetMouse()

    -- ===== CONFIGURAÇÕES =====
    local Config = {
        AimbotEnabled = false,
        AimlockEnabled = false,
        ESPEnabled = false,
        ShowBoxes = true,
        ShowLines = true,
        ShowNames = true,
        ShowHealth = true,
        ShowDistance = true,
        ESPColor = Color3.fromRGB(0, 170, 255),
        AimPart = "Head",
        FOV = 300,
        Smoothness = 0.25,
        TeamCheck = true,
    }

    -- ===== VARIÁVEIS =====
    local ToggleKey = Enum.KeyCode.X
    local HubVisible = false
    local SelectedTarget = nil
    local ESPObjects = {}
    local ScreenGui = nil
    local HubFrame = nil
    local isDragging = false
    local dragStart = nil
    local startPos = nil
    local Connections = {}

    -- ===== FUNÇÕES =====
    local function IsValidTarget(player)
        if not player then return false end
        if player == LocalPlayer then return false end
        if not player.Character or not player.Character:FindFirstChild("Humanoid") then return false end
        local humanoid = player.Character.Humanoid
        if humanoid.Health <= 0 then return false end
        if Config.TeamCheck and player.Team == LocalPlayer.Team and LocalPlayer.Team ~= nil then return false end
        return true
    end

    local function GetClosestPlayer()
        local closest = nil
        local shortestDistance = Config.FOV
        local mousePos = Vector2.new(Mouse.X, Mouse.Y)
        
        for _, player in pairs(Players:GetPlayers()) do
            if IsValidTarget(player) then
                local part = player.Character:FindFirstChild(Config.AimPart) or player.Character:FindFirstChild("HumanoidRootPart")
                if part then
                    local screenPos, onScreen = Camera:WorldToViewportPoint(part.Position)
                    if onScreen then
                        local distance = (Vector2.new(screenPos.X, screenPos.Y) - mousePos).Magnitude
                        if distance < shortestDistance then
                            shortestDistance = distance
                            closest = player
                        end
                    end
                end
            end
        end
        return closest
    end

    local function GetPart(player)
        if not player or not player.Character then return nil end
        local part = player.Character:FindFirstChild(Config.AimPart)
        if not part then
            part = player.Character:FindFirstChild("HumanoidRootPart")
        end
        return part
    end

    -- ===== AIMBOT =====
    local function Aimbot()
        if not Config.AimbotEnabled then return end
        
        local target = GetClosestPlayer()
        if target then
            local part = GetPart(target)
            if part then
                local lookAt = part.Position - Camera.CFrame.Position
                local newCFrame = CFrame.new(Camera.CFrame.Position, Camera.CFrame.Position + lookAt)
                Camera.CFrame = Camera.CFrame:Lerp(newCFrame, Config.Smoothness)
            end
        end
    end

    -- ===== AIMLOCK =====
    local function Aimlock()
        if not Config.AimlockEnabled or not SelectedTarget then return end
        
        if not IsValidTarget(SelectedTarget) then
            SelectedTarget = nil
            return
        end
        
        local part = GetPart(SelectedTarget)
        if part then
            local lookAt = part.Position - Camera.CFrame.Position
            local newCFrame = CFrame.new(Camera.CFrame.Position, Camera.CFrame.Position + lookAt)
            Camera.CFrame = Camera.CFrame:Lerp(newCFrame, Config.Smoothness)
        end
    end

