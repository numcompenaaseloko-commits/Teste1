local function toggleHub(visible)
    local tweenInfo = TweenInfo.new(0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
    local targetPos = visible and UDim2.new(0.5, -190, 0.5, -275) or UDim2.new(0.5, -190, 0.5, 1000)
    
    local tween = TweenService:Create(mainFrame, tweenInfo, {Position = targetPos})
    tween:Play()
    
    openBtn.Visible = not visible
end

