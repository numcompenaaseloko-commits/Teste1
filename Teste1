--[[
    Snow Hub - Script UI Premium para Roblox
    Estrutura modular com design moderno e escuro
    Carregamento via loadstring do GitHub
]]

-- Módulo principal da interface
local SnowHub = {}

-- Configurações
local Config = {
    Theme = {
        Background = Color3.fromRGB(20, 20, 25),
        Surface = Color3.fromRGB(30, 30, 38),
        Accent = Color3.fromRGB(0, 120, 255),
        Text = Color3.fromRGB(255, 255, 255),
        TextDim = Color3.fromRGB(180, 180, 190),
        Border = Color3.fromRGB(45, 45, 55)
    },
    FOV = {
        Radius = 150,        -- Raio do círculo FOV (configurável)
        Color = Color3.fromRGB(255, 0, 0),
        Transparency = 0.3
    },
    Animation = {
        Duration = 0.3
    }
}

-- Serviços
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")

local player = Players.LocalPlayer
local mouse = player:GetMouse()

-- Estado do Aimbot
local aimbotActive = false
local fovCircle = nil

-- ============================================
-- MÓDULO: UI Elements (Criação de componentes)
-- ============================================
local UI = {}

-- Cria um frame com estilo padrão
function UI.CreateFrame(parent, size, position, properties)
    local frame = Instance.new("Frame")
    frame.Parent = parent
    frame.Size = size
    frame.Position = position
    frame.BackgroundColor3 = Config.Theme.Surface
    frame.BorderSizePixel = 0
    
    -- Cantos arredondados
    local corner = Instance.new("UICorner")
    corner.Parent = frame
    corner.CornerRadius = UDim.new(0, 8)
    
    -- Sombra sutil
    local shadow = Instance.new("Shadow")
    shadow.Parent = frame
    
    if properties then
        for prop, value in pairs(properties) do
            frame[prop] = value
        end
    end
    
    return frame
end

-- Cria um texto com estilo
function UI.CreateText(parent, text, size, position, properties)
    local label = Instance.new("TextLabel")
    label.Parent = parent
    label.Size = size
    label.Position = position
    label.Text = text
    label.TextColor3 = Config.Theme.Text
    label.TextScaled = false
    label.Font = Enum.Font.GothamBold
    label.TextSize = 18
    label.BackgroundTransparency = 1
    label.TextXAlignment = Enum.TextXAlignment.Center
    label.TextYAlignment = Enum.TextYAlignment.Center
    
    if properties then
        for prop, value in pairs(properties) do
            label[prop] = value
        end
    end
    
    return label
end

-- Cria um botão estilizado
function UI.CreateButton(parent, text, size, position, callback, properties)
    local button = UI.CreateFrame(parent, size, position, {
        BackgroundColor3 = Config.Theme.Accent
    })
    
    -- Corner mais arredondado para botões
    local corner = button:FindFirstChild("UICorner")
    if corner then
        corner.CornerRadius = UDim.new(0, 12)
    end
    
    local label = UI.CreateText(button, text, UDim2.new(1, 0, 1, 0), UDim2.new(0, 0, 0, 0), {
        TextSize = 16,
        TextColor3 = Color3.fromRGB(255, 255, 255)
    })
    
    -- Efeito hover
    button.MouseEnter:Connect(function()
        TweenService:Create(button, TweenInfo.new(0.15), {
            BackgroundColor3 = Color3.fromRGB(30, 150, 255)
        }):Play()
    end)
    
    button.MouseLeave:Connect(function()
        TweenService:Create(button, TweenInfo.new(0.15), {
            BackgroundColor3 = Config.Theme.Accent
        }):Play()
    end)
    
    button.MouseButton1Click:Connect(callback)
    
    return button
end

-- ============================================
-- MÓDULO: Aimbot (Lógica do Aimbot)
-- ============================================
local Aimbot = {}

-- Cria o círculo FOV
function Aimbot.CreateFOVCircle()
    if fovCircle then
        fovCircle:Destroy()
        fovCircle = nil
    end
    
    local circle = Instance.new("Frame")
    circle.Parent = player.PlayerGui
    circle.Size = UDim2.new(0, Config.FOV.Radius * 2, 0, Config.FOV.Radius * 2)
    circle.Position = UDim2.new(0.5, -Config.FOV.Radius, 0.5, -Config.FOV.Radius)
    circle.BackgroundColor3 = Config.FOV.Color
    circle.BackgroundTransparency = 0.8
    circle.BorderSizePixel = 0
    circle.ZIndex = 999
    
    -- Borda do círculo
    local border = Instance.new("Frame")
    border.Parent = circle
    border.Size = UDim2.new(1, -4, 1, -4)
    border.Position = UDim2.new(0, 2, 0, 2)
    border.BackgroundTransparency = 1
    border.BorderSizePixel = 3
    border.BorderColor3 = Config.FOV.Color
    border.ZIndex = 1000
    
    -- Cantos arredondados para o círculo
    local corner = Instance.new("UICorner")
    corner.Parent = circle
    corner.CornerRadius = UDim.new(1, 0)
    
    -- Efeito de brilho sutil
    local glow = Instance.new("Frame")
    glow.Parent = circle
    glow.Size = UDim2.new(1, 10, 1, 10)
    glow.Position = UDim2.new(0, -5, 0, -5)
    glow.BackgroundColor3 = Config.FOV.Color
    glow.BackgroundTransparency = 0.9
    glow.BorderSizePixel = 0
    glow.ZIndex = 998
    
    local glowCorner = Instance.new("UICorner")
    glowCorner.Parent = glow
    glowCorner.CornerRadius = UDim.new(1, 0)
    
    fovCircle = circle
end

-- Remove o círculo FOV
function Aimbot.RemoveFOVCircle()
    if fovCircle then
        fovCircle:Destroy()
        fovCircle = nil
    end
end

-- Alterna o estado do Aimbot
function Aimbot.Toggle()
    aimbotActive = not aimbotActive
    
    if aimbotActive then
        Aimbot.CreateFOVCircle()
    else
        Aimbot.RemoveFOVCircle()
    end
    
    return aimbotActive
end

-- ============================================
-- MÓDULO: Interface Principal (Snow Hub)
-- ============================================
local function CreateMainUI()
    -- Container principal
    local screenGui = Instance.new("ScreenGui")
    screenGui.Parent = player.PlayerGui
    screenGui.Name = "SnowHub"
    screenGui.ResetOnSpawn = false
    
    -- Frame principal
    local mainFrame = UI.CreateFrame(screenGui, UDim2.new(0, 380, 0, 240), UDim2.new(0.5, -190, 0.5, -120), {
        BackgroundColor3 = Config.Theme.Background,
        ClipsDescendants = true
    })
    
    -- Sombra externa
    local outerShadow = Instance.new("Frame")
    outerShadow.Parent = mainFrame
    outerShadow.Size = UDim2.new(1, 20, 1, 20)
    outerShadow.Position = UDim2.new(0, -10, 0, -10)
    outerShadow.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
    outerShadow.BackgroundTransparency = 0.5
    outerShadow.BorderSizePixel = 0
    outerShadow.ZIndex = -1
    
    local outerCorner = Instance.new("UICorner")
    outerCorner.Parent = outerShadow
    outerCorner.CornerRadius = UDim.new(0, 12)
    
    -- Barra superior (título + botões)
    local topBar = UI.CreateFrame(mainFrame, UDim2.new(1, 0, 0, 50), UDim2.new(0, 0, 0, 0), {
        BackgroundColor3 = Color3.fromRGB(25, 25, 32)
    })
    
    -- Título
    local title = UI.CreateText(topBar, "Snow Hub", UDim2.new(0, 200, 1, 0), UDim2.new(0, 15, 0, 0), {
        TextSize = 22,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextColor3 = Color3.fromRGB(255, 255, 255)
    })
    
    -- Ícone decorativo
    local icon = UI.CreateText(topBar, "❄", UDim2.new(0, 30, 1, 0), UDim2.new(0, -35, 0, 0), {
        TextSize = 20,
        TextColor3 = Config.Theme.Accent
    })
    
    -- Botão Minimizar
    local minButton = UI.CreateButton(topBar, "−", UDim2.new(0, 36, 0, 30), UDim2.new(1, -90, 0.5, -15), function()
        mainFrame.Size = UDim2.new(0, 380, 0, 50)
        TweenService:Create(mainFrame, TweenInfo.new(0.3), {
            Size = UDim2.new(0, 380, 0, 50)
        }):Play()
    end, {
        BackgroundColor3 = Color3.fromRGB(45, 45, 55)
    })
    
    -- Botão Fechar
    local closeButton = UI.CreateButton(topBar, "✕", UDim2.new(0, 36, 0, 30), UDim2.new(1, -45, 0.5, -15), function()
        screenGui:Destroy()
    end, {
        BackgroundColor3 = Color3.fromRGB(180, 40, 40)
    })
    
    -- Conteúdo principal
    local content = UI.CreateFrame(mainFrame, UDim2.new(1, -40, 1, -80), UDim2.new(0, 20, 0, 70), {
        BackgroundTransparency = 1
    })
    
    -- Botão Aimbot
    local aimbotButton = UI.CreateButton(content, "Aimbot: OFF", UDim2.new(0, 200, 0, 45), UDim2.new(0.5, -100, 0.5, -22.5), function()
        local state = Aimbot.Toggle()
        aimbotButton:FindFirstChild("TextLabel").Text = "Aimbot: " .. (state and "ON" or "OFF")
        
        -- Mudar cor conforme estado
        TweenService:Create(aimbotButton, TweenInfo.new(0.2), {
            BackgroundColor3 = state and Color3.fromRGB(200, 30, 30) or Config.Theme.Accent
        }):Play()
    end, {
        BackgroundColor3 = Config.Theme.Accent
    })
    
    -- Status do FOV
    local fovStatus = UI.CreateText(content, "FOV: " .. Config.FOV.Radius, UDim2.new(0, 120, 0, 20), UDim2.new(0.5, -60, 1, -25), {
        TextSize = 13,
        TextColor3 = Config.Theme.TextDim
    })
    
    -- Informações adicionais
    local infoText = UI.CreateText(content, "❄ Snow Hub v1.0", UDim2.new(0, 150, 0, 20), UDim2.new(0, 5, 1, -25), {
        TextSize = 12,
        TextColor3 = Config.Theme.TextDim,
        TextXAlignment = Enum.TextXAlignment.Left
    })
    
    -- ============================================
    -- DRAGGABLE: Interface arrastável
    -- ============================================
    local dragging = false
    local dragInput = nil
    local dragStart = nil
    local startPos = nil
    
    topBar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            dragStart = input.Position
            startPos = mainFrame.Position
            
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                end
            end)
        end
    end)
    
    topBar.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement then
            dragInput = input
        end
    end)
    
    UserInputService.InputChanged:Connect(function(input)
        if input == dragInput and dragging then
            local delta = input.Position - dragStart
            mainFrame.Position = UDim2.new(
                startPos.X.Scale,
                startPos.X.Offset + delta.X,
                startPos.Y.Scale,
                startPos.Y.Offset + delta.Y
            )
        end
    end)
    
    -- Animação de entrada
    mainFrame.BackgroundTransparency = 1
    TweenService:Create(mainFrame, TweenInfo.new(0.4), {
        BackgroundTransparency = 0
    }):Play()
    
    return screenGui
end

-- ============================================
-- INICIALIZAÇÃO
-- ============================================
function SnowHub.Init()
    -- Garantir que não há múltiplas instâncias
    if player.PlayerGui:FindFirstChild("SnowHub") then
        player.PlayerGui.SnowHub:Destroy()
    end
    
    CreateMainUI()
end

-- ============================================
-- EXPORTAÇÃO PARA LOADSTRING
-- ============================================
return SnowHub
